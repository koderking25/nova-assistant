// Cloudflare Workers settings: serves the website in the "site" folder at saynova.app.
// Deploy with:  npx wrangler deploy
{
  "name": "nova-assistant",
  "compatibility_date": "2026-10-01",
  // The site lives at saynova.app only; the workers.dev address and preview addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // The site's own address. Cloudflare sets up the DNS record and the certificate by itself.
  "routes": [
    { "pattern": "saynova.app", "custom_domain": true },
    { "pattern": "www.saynova.app", "custom_domain": true }
  ]
}
